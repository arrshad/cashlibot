# ----- Telegram -----
# Get one from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Username of your bot (no @). Used to build deep-links.
TELEGRAM_BOT_USERNAME=

# ----- Postgres -----
POSTGRES_USER=cashlibot
POSTGRES_PASSWORD=cashlibot_dev_only_change_me
POSTGRES_DB=cashlibot
# Internal hostname/port — these are what backend uses inside the compose network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ----- App -----
# debug | info | warning | error
LOG_LEVEL=info
# JWT signing secret for the admin dashboard. Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-to-a-real-secret

# ----- AI providers (keep blank if you aren't using AI features yet) -----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----- Mini App / Admin URLs -----
# Public URL your Mini App is served at (HTTPS required by Telegram in prod).
# For local dev without a tunnel, leave blank.
# With the prod Traefik overlay this is https://${PUBLIC_HOSTNAME}.
MINIAPP_URL=
# Public URL for the admin dashboard. The bot's /admin command builds the
# login link from this. Defaults to http://localhost:5174 when empty.
# With the prod Traefik overlay this is https://${PUBLIC_HOSTNAME}/admin.
ADMIN_URL=

# ----- Prod deployment (docker-compose.prod.yml) -----
# The hostname Traefik should match on the `web` external network.
# Only used by docker-compose.prod.yml; ignore for local dev.
PUBLIC_HOSTNAME=
# Name of the ACME certResolver configured in Traefik's static config.
# Defaults to "letsencrypt" if unset.
TRAEFIK_CERT_RESOLVER=letsencrypt
